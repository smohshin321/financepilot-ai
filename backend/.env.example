APP_NAME=FinancePilot AI
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financepilot
POSTGRES_USER=financepilot
POSTGRES_PASSWORD=financepilot_dev_password
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_COMMAND_TIMEOUT_SECONDS=30
JWT_SECRET_KEY=replace-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
